# ── Supabase (서버 전용 — 브라우저 접근 없음) ──
# 대시보드 > Project Settings > API 에서 복사
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── 카카오 Maps JavaScript 키 (브라우저 노출 — 등록 도메인에서만 동작) ──
# developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
NEXT_PUBLIC_KAKAO_JS_KEY=YOUR-KAKAO-JS-KEY

# ── (Day 8) 레이트리밋 — Upstash Redis ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
